# EduCore — variables de entorno de PRODUCCIÓN
# --------------------------------------------------------------------------
# Copia este archivo a `.env` en la raíz del repo:
#
#     cp .env.prod.example .env
#
# y rellena los marcadores `<...>`. En Dokploy, pega el contenido en las
# variables del stack en lugar de crear el archivo.
#
# `docker-compose.production.yml` y `docker-compose.dokploy.yml` leen `.env`.
# Docker Compose también lo usa para interpolar `${VITE_API_URL}`,
# `${DJANGO_CPU}`, etc. de esos compose.
# Los frontends NO usan este archivo: `VITE_API_URL` llega como build arg.

# General
# --------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# Generar con:
#   python3 -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=<generar>
# Ruta aleatoria del admin. Déjala vacía y configúrala aparte; este ejemplo no
# la publica a propósito.
DJANGO_ADMIN_URL=
DJANGO_ALLOWED_HOSTS=.<tu-dominio>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<tu-dominio>
DJANGO_CORS_ALLOWED_ORIGINS=https://<tu-dominio>
CORS_ALLOW_CREDENTIALS=False
DJANGO_NAME_LOG_FILE=django_prod
DJANGO_DEBUG=False

# Security
# --------------------------------------------------------------------------
# TIP: mejor off usando DNS, sin embargo, redirect también sirve.
DJANGO_SECURE_SSL_REDIRECT=False

# PostgreSQL
# --------------------------------------------------------------------------
# El Postgres gestionado por Dokploy (host externo), no el servicio del compose.
POSTGRES_HOST=<hostname-del-postgres-de-dokploy>
POSTGRES_PORT=5432
POSTGRES_DB=educore
POSTGRES_USER=<cambiar>
POSTGRES_PASSWORD=<cambiar>

# pgbouncer
# --------------------------------------------------------------------------
# pool_mode=transaction: para DDL usa la conexión directa a Postgres.
PGB_POSTGRES_HOST=pgbouncer
PGB_POSTGRES_PORT=6432
PGB_POSTGRES_DB=educore
PGB_POSTGRES_USER=<cambiar>
PGB_POSTGRES_PASSWORD=<cambiar>

# Database
# --------------------------------------------------------------------------
# Debe coincidir con los valores PGB_POSTGRES_* de arriba (sin interpolación:
# la expansión de ${VAR} en env_file no es fiable).
DATABASE_URL=postgres://<cambiar>:<cambiar>@pgbouncer:6432/educore

# Email
# --------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=

# Gunicorn
# --------------------------------------------------------------------------
WEB_CONCURRENCY=4

# Redis
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Flower
# --------------------------------------------------------------------------
CELERY_FLOWER_USER=<cambiar>
CELERY_FLOWER_PASSWORD=<cambiar>

# JWT
# --------------------------------------------------------------------------
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=true

# Traefik / Domain
# --------------------------------------------------------------------------
# Dominio público del deploy (el Traefik de Dokploy enruta por este Host).
# El Traefik interno (servicio `traefik` del compose) usa ${DOMAIN} en
# traefik.template.yml y enruta /api/ -> django, /api/media/* -> nginx,
# el resto -> frontend.
DOMAIN=<tu-dominio>

# VITE_API_URL se inyecta como build arg del frontend. En producción el
# frontend consume el mismo dominio que el backend (Traefik enruta
# ${DOMAIN}/api/* a Django), por eso va en ruta relativa.
VITE_API_URL=/

# Dokploy — límites de recursos por servicio
# --------------------------------------------------------------------------
# docker-compose.dokploy.yml usa estos valores en `deploy.resources.limits`.
# Si no se definen, el compose aplica el default `:-1` / `:-1g`.
# Formato: cpus = número o decimal ('0.5', '1', '2'), memory = '<num><unidad>'
# donde unidad = b|k|m|g (ej. '512m', '1g', '2g').
# Los `reservations` del compose ya tienen valores seguros por defecto
# (cpus '0.1'-'0.5', memory 123M-256M); estos `limits` son el techo máximo.
DJANGO_CPU=1
DJANGO_RAM=1g
PGBOUNCER_CPU=1
PGBOUNCER_RAM=1g
TRAEFIK_CPU=1
TRAEFIK_RAM=1g
CELERYWORKER_CPU=1
CELERYWORKER_RAM=1g
CELERYBEAT_CPU=1
CELERYBEAT_RAM=1g
NGINX_CPU=1
NGINX_RAM=1g
FRONTEND_CPU=1
FRONTEND_RAM=1g

# Número de réplicas del servicio `celeryworker`
# (compose: `replicas: ${CANT_WORKERS_CELERY:-2}`).
# Sube este valor si tienes picos de tareas async; cada réplica consume
# CELERYWORKER_CPU/RAM.
CANT_WORKERS_CELERY=2
