# EduCore — variables de entorno de DESARROLLO
# --------------------------------------------------------------------------
# Copia este archivo a `.env.local` en la raíz del repo:
#
#     cp .env.local.example .env.local
#
# `docker-compose.local.yml` y `backend/docker-compose.docs.yml` leen `.env.local`.
# Los frontends NO usan este archivo: cada uno conserva su propio `frontend/.env`
# y `frontend-A2/.env` (solo llevan VITE_API_URL).
#
# Los valores de abajo son los de desarrollo de la plantilla (debug/debug).
# No sirven para producción.

# General
# --------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
DJANGO_SECRET_KEY=local-development-secret-key-not-for-production
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8002,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8002
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8002,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8002
CORS_ALLOW_CREDENTIALS=True
DJANGO_NAME_LOG_FILE=django_dev
DJANGO_DEBUG=true

# PostgreSQL
# --------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=educore
POSTGRES_USER=debug
POSTGRES_PASSWORD=debug

# pgbouncer
# --------------------------------------------------------------------------
# pool_mode=transaction: para DDL usa `just manage-direct-db` / `just pytest-direct-db`.
PGB_POSTGRES_HOST=pgbouncer
PGB_POSTGRES_PORT=6432
PGB_POSTGRES_DB=educore
PGB_POSTGRES_USER=debug
PGB_POSTGRES_PASSWORD=debug

# Database (URL concreta — sin interpolación de shell, que no se expande)
# --------------------------------------------------------------------------
DATABASE_URL=postgres://debug:debug@pgbouncer:6432/educore

# Redis
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Flower
# --------------------------------------------------------------------------
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# JWT
# --------------------------------------------------------------------------
JWT_REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=false
